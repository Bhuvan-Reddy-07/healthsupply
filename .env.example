# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthsupply
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/healthsupply

# Standalone / Local SQLite fallback option for lightweight testing
# DATABASE_URL=sqlite:///./healthsupply.db

# NATS Configuration
NATS_URL=nats://nats:4222

# Security & Auth
SECRET_KEY=dev-secret-key-change-in-production-super-secure-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Logging & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Simulation Parameters
SIM_FACILITIES_PER_COUNTRY=100
SIM_MONTHS=24
SIM_ITEMS_COUNT=150
